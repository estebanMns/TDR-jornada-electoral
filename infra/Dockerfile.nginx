# syntax=docker/dockerfile:1.7
# nginx + static build of the juror PWA (apps/jurado), served at /jurado/.
# Templates, snippets and certificates are still mounted by docker compose.

FROM node:22-alpine AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY apps/server/package.json apps/server/
COPY apps/jurado/package.json apps/jurado/
COPY packages/shared/package.json packages/shared/
COPY packages/contracts/package.json packages/contracts/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@preconteo/jurado..."
COPY packages/contracts packages/contracts
COPY apps/jurado apps/jurado
RUN pnpm --filter @preconteo/jurado build

FROM nginx:1.27-alpine
COPY --from=build /repo/apps/jurado/dist /usr/share/nginx/jurado
