# syntax=docker/dockerfile:1.7
# Actas service (Jose): actas1…actasN, same image, only INSTANCE_ID changes.
# Context: repo root. Also carries scripts/ so the seed can run inside the VM:
#   docker compose -f infra/docker-compose.yml exec actas1 sh -c 'cd /repo && node --import tsx scripts/seed.ts --no-file'

FROM node:22-alpine AS deps
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY apps/server/package.json apps/server/
COPY apps/jurado/package.json apps/jurado/
COPY packages/shared/package.json packages/shared/
COPY packages/contracts/package.json packages/contracts/
# The service runs TypeScript through tsx; the root brings the seed's dependencies.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@preconteo/server..." --filter preconteo

FROM deps AS runtime
ENV NODE_ENV=production ACTAS_PORT=3001
RUN addgroup -S app && adduser -S app -G app
COPY packages/contracts packages/contracts
COPY apps/server/src apps/server/src
COPY apps/server/tsconfig.json apps/server/
COPY scripts scripts
RUN mkdir -p /repo/apps/server/.data && chown -R app:app /repo/apps/server/.data

USER app
WORKDIR /repo/apps/server
EXPOSE 3001
CMD ["node", "--import", "tsx", "src/main.ts"]
