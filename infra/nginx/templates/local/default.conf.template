# Local: 2 instancias, sin TLS. Mismo comportamiento de balanceo que producción.

upstream preconteo {
  server app1:3000;
  server app2:3000;
  keepalive 64;
}

upstream actas {
  server actas1:3001;
  server actas2:3001;
  keepalive 16;
}

server {
  listen 80;
  include /etc/nginx/snippets/rutas.conf;
}
