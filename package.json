{
  "name": "preconteo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @preconteo/web dev",
    "dev:actas": "pnpm --filter @preconteo/server dev",
    "dev:jurado": "pnpm --filter @preconteo/jurado dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @preconteo/web start",
    "start:actas": "pnpm --filter @preconteo/server start",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "tsc -p scripts && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "fake-acta": "tsx --env-file-if-exists=.env scripts/fake-acta.ts",
    "dev-token": "tsx --env-file-if-exists=.env scripts/dev-token.ts",
    "fake:dudosas": "pnpm --filter @preconteo/web fake:dudosas",
    "smoke": "pnpm --filter @preconteo/web smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@preconteo/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.0",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "ioredis": "^5.11.1",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
