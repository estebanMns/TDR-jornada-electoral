{
  "name": "electoral",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:server": "pnpm --filter @electoral/server dev",
    "dev:web": "pnpm --filter @electoral/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p scripts && pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed": "tsx scripts/seed.ts",
    "fake-acta": "tsx scripts/fake-acta.ts",
    "dev-token": "tsx scripts/dev-token.ts"
  },
  "devDependencies": {
    "@electoral/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
