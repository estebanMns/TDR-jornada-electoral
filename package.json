{
  "name": "electoral",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @electoral/web dev",
    "dev:server": "pnpm --filter @electoral/server dev",
    "dev:web": "pnpm --filter @electoral/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p scripts && pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed": "tsx scripts/seed.ts",
    "fake-acta": "tsx scripts/fake-acta.ts",
    "dev-token": "tsx scripts/dev-token.ts",
    "fake-events": "tsx scripts/fake-events.ts",
    "load:publico": "pnpm --filter @electoral/loadtest publico",
    "load:jornada": "pnpm --filter @electoral/loadtest jornada",
    "load:lento": "pnpm --filter @electoral/loadtest lento",
    "load:avalancha": "pnpm --filter @electoral/loadtest avalancha"
  },
  "devDependencies": {
    "@electoral/shared": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.11.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
