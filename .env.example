# --- Instancia ---
# Lo asigna docker-compose (app1…app8). En local puedes dejar app-local.
INSTANCE_ID=app-local
PORT=3000
NODE_ENV=development

# --- Seguridad ---
# openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-de-64-caracteres-hexadecimales-0000000
JWT_EXPIRACION=8h

# --- Redis ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=cambia-esto
# Pruebas (servicio redis-test del compose)
REDIS_TEST_URL=redis://localhost:6380

# --- Supabase (service_role SOLO en el servidor; nunca al frontend ni al repo) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...
SUPABASE_BUCKET_FOTOS=actas-fotos

# --- Difusión pública (Evelyn) ---
WINDOW_MS=2000

# --- Despliegue ---
PUBLIC_URL=https://preconteo-xxx.duckdns.org
# Subdominio para el certificado y la plantilla de nginx (sin https://)
DOMINIO=preconteo-xxx.duckdns.org

# --- Actas service (Jose: apps/server + apps/jurado) ---
# Runs next to the Next.js server; nginx sends /api/actas to it.
ACTAS_PORT=3001
# Photos go to SUPABASE_BUCKET_FOTOS; without Supabase they are stored here.
PHOTO_DIR=./.data/photos

# --- Seed (TEST ENVIRONMENT ONLY) ---
# Shared demo password for the 6,400 jurors (jurado0001…jurado6400) created by `pnpm seed`.
SEED_JUROR_PASSWORD=jurado-demo-2026
